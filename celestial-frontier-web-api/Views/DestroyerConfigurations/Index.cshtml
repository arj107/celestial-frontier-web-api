@model IEnumerable<celestial_frontier_web_api.Models.DestroyerConfiguration>

@{
    ViewData["Title"] = "Destroyer Configurations";
}

<h1>Destroyer Configurations</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Armor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Destroyer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FuelSystem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Payload1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Payload2)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PointDefenseSystem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Thruster)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WeaponFrame1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WeaponFrame2)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Armor.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Destroyer.Class)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.Username)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FuelSystem.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Payload1.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Payload2.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PointDefenseSystem.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Thruster.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WeaponFrame1.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WeaponFrame2.Title)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.DestroyerConfigurationGuid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.DestroyerConfigurationGuid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.DestroyerConfigurationGuid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
