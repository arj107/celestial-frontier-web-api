@model IEnumerable<celestial_frontier_web_api.Models.Fleet>

@{
    ViewData["Title"] = "Fleets";
}

<h1>Fleets</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CrewCapacity)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.User.Username)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CrewCapacity)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FleetGuid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FleetGuid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.FleetGuid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
