@model IEnumerable<celestial_frontier_web_api.Models.PointDefenseSystem>

@{
    ViewData["Title"] = "Point Defense Systems";
}

<h1>Point Defense Systems</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ModulePointsCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mass)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SpecificHeatCapacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CountermeasureCapacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CountermeasureRegenerationRate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Efficiency)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PowerLevel)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ModulePointsCost)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Mass)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SpecificHeatCapacity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CountermeasureCapacity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CountermeasureRegenerationRate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Efficiency)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PowerLevel.Text)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PointDefenseSystemGuid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.PointDefenseSystemGuid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.PointDefenseSystemGuid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
