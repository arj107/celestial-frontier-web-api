@model celestial_frontier_web_api.Models.FleetFighter

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>FleetFighter</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FleetFighterGuid" class="control-label"></label>
                <input asp-for="FleetFighterGuid" class="form-control" value="@Guid.NewGuid()" disabled/>
