            </div>
            <div class="form-group">
                <label asp-for="FleetGuid" class="control-label">Fleet</label>
                <select asp-for="FleetGuid" class ="form-control" asp-items="ViewBag.FleetGuid"></select>
            </div>
            <div class="form-group">
                <label asp-for="FighterGuid" class="control-label">Fighter</label>
                <select asp-for="FighterGuid" class ="form-control" asp-items="ViewBag.FighterGuid"></select>
            </div>
            <div class="form-group">
                <label asp-for="WeaponFrameGuid" class="control-label">WeaponFrame</label>
                <select asp-for="WeaponFrameGuid" class ="form-control" asp-items="ViewBag.WeaponFrameGuid"></select>
            </div>
            <div class="form-group">
                <label asp-for="PayloadGuid" class="control-label">Payload</label>
                <select asp-for="PayloadGuid" class ="form-control" asp-items="ViewBag.PayloadGuid"></select>
            </div>
            <div class="form-group">
                <label asp-for="ArmorGuid" class="control-label">Armor</label>
                <select asp-for="ArmorGuid" class ="form-control" asp-items="ViewBag.ArmorGuid"></select>
            </div>
            <div class="form-group">
                <label asp-for="PointDefenseSystemGuid" class="control-label">PointDefenseSystem</label>
                <select asp-for="PointDefenseSystemGuid" class ="form-control" asp-items="ViewBag.PointDefenseSystemGuid"></select>
            </div>
            <div class="form-group">
                <label asp-for="FuelSystemGuid" class="control-label">FuelSystem</label>
                <select asp-for="FuelSystemGuid" class ="form-control" asp-items="ViewBag.FuelSystemGuid"></select>
            </div>
            <div class="form-group">
                <label asp-for="ThrusterGuid" class="control-label">Thruster</label>
                <select asp-for="ThrusterGuid" class ="form-control" asp-items="ViewBag.ThrusterGuid"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
