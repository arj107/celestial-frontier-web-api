@model IEnumerable<celestial_frontier_web_api.Models.FrigateConfiguration>

@{
    ViewData["Title"] = "Frigate Configurations";
}

<h1>Frigate Configurations</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Armor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Frigate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FuelSystem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Payload)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PointDefenseSystem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Thruster)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WeaponFrame)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Armor.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Frigate.Class)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.Username)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FuelSystem.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Payload.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PointDefenseSystem.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Thruster.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WeaponFrame.Description)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FrigateConfigurationGuid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FrigateConfigurationGuid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.FrigateConfigurationGuid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
