@model IEnumerable<celestial_frontier_web_api.Models.WeaponFrame>

@{
    ViewData["Title"] = "Weapon Frames";
}

<h1>Weapon Frames</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ModulePointsCost)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mass)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SpecificHeatCapacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BaseMagSize)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BaseAccuracyModifier)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BaseTurnsToArm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BaseCriticalHitChance)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PowerLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WeaponFrameType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ModulePointsCost)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Mass)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SpecificHeatCapacity)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BaseMagSize)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BaseAccuracyModifier)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BaseTurnsToArm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BaseCriticalHitChance)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PowerLevel.Text)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WeaponFrameType.Text)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.WeaponFrameGuid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.WeaponFrameGuid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.WeaponFrameGuid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
