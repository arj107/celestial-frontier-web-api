@model celestial_frontier_web_api.Models.FleetBattlecruiser

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>FleetBattlecruiser</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FleetBattlecruiserGuid" class="control-label"></label>
                <input asp-for="FleetBattlecruiserGuid" class="form-control" value="@Guid.NewGuid()" disabled/>
                <span asp-validation-for="FleetBattlecruiserGuid" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BattlecruiserConfigurationGuid" class="control-label"></label>
                <select asp-for="BattlecruiserConfigurationGuid" class ="form-control" asp-items="ViewBag.BattlecruiserConfigurationGuid"></select>
            </div>
            <div class="form-group">
                <label asp-for="FleetGuid" class="control-label"></label>
                <select asp-for="FleetGuid" class ="form-control" asp-items="ViewBag.FleetGuid"></select>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
