@model IEnumerable<celestial_frontier_web_api.Models.CorvetteConfiguration>

@{
    ViewData["Title"] = "Corvette Configurations";
}

<h1>Corvette Configurations</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Armor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Corvette)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FuelSystem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Payload)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PointDefenseSystem)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Thruster)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.WeaponFrame)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Armor.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Corvette.Class)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.Username)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FuelSystem.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Payload.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PointDefenseSystem.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Thruster.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WeaponFrame.Title)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.CorvetteConfigurationGuid">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.CorvetteConfigurationGuid">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.CorvetteConfigurationGuid">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
